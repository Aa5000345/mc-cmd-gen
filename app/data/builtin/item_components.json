{
  "version": "1.21.1",
  "note": "1.21 物品组件。group 用于界面分组；applies 为一组物品标签，用于「是否适用于该物品」的提示（items.json 的 tags 字段）。",
  "groups": [
    ["name", "名称与描述"],
    ["enchant", "附魔"],
    ["combat", "战斗与耐久"],
    ["attribute", "属性与修饰"],
    ["appearance", "外观与染色"],
    ["food", "食物与药水"],
    ["container", "容器与收纳"],
    ["misc", "其他"]
  ],
  "components": [
    {
      "id": "minecraft:custom_name",
      "display": "自定义名称",
      "kind": "nbt",
      "group": "name",
      "default": "\"重命名物品\"",
      "hint": "文本组件；纯中文可直接写，例如 \"神剑\" 或 {\"text\":\"神剑\",\"color\":\"red\"}"
    },
    {
      "id": "minecraft:item_name",
      "display": "物品名（优先于 custom_name）",
      "kind": "nbt",
      "group": "name",
      "default": "\"物品名\"",
      "hint": "会覆盖物品原本的名字，且不可被铁砧改名覆盖"
    },
    {
      "id": "minecraft:lore",
      "display": "描述（Lore）",
      "kind": "nbt",
      "group": "name",
      "default": "[\"第一行\",\"第二行\"]",
      "hint": "文本组件列表，每项一行"
    },
    {
      "id": "minecraft:hide_additional_tooltip",
      "display": "隐藏额外提示",
      "kind": "bool",
      "group": "name",
      "default": "1b"
    },
    {
      "id": "minecraft:enchantments",
      "display": "附魔",
      "kind": "nbt",
      "group": "enchant",
      "applies": ["tool", "weapon", "armor", "book", "enchantable"],
      "default": "{\"levels\":{\"minecraft:sharpness\":5}}",
      "hint": "1.21 为 {levels:{<附魔>:<等级>}}；工具/武器/盔甲/书可用"
    },
    {
      "id": "minecraft:stored_enchantments",
      "display": "附魔书附魔",
      "kind": "nbt",
      "group": "enchant",
      "applies": ["book"],
      "default": "{\"levels\":{\"minecraft:sharpness\":5}}",
      "hint": "仅对附魔书有意义"
    },
    {
      "id": "minecraft:enchantment_glint_override",
      "display": "附魔光效覆盖",
      "kind": "bool",
      "group": "enchant",
      "default": "1b",
      "hint": "1b 强制发光，0b 强制不发光"
    },
    {
      "id": "minecraft:repair_cost",
      "display": "修复成本（铁砧惩罚）",
      "kind": "int",
      "group": "combat",
      "default": "0"
    },
    {
      "id": "minecraft:damage",
      "display": "已损耗值",
      "kind": "int",
      "group": "combat",
      "applies": ["tool", "weapon", "armor", "durable"],
      "default": "0"
    },
    {
      "id": "minecraft:max_damage",
      "display": "最大耐久",
      "kind": "int",
      "group": "combat",
      "applies": ["tool", "weapon", "armor"],
      "default": "2031"
    },
    {
      "id": "minecraft:unbreakable",
      "display": "无法破坏",
      "kind": "bool",
      "group": "combat",
      "default": "1b",
      "hint": "1b 表示永不损坏"
    },
    {
      "id": "minecraft:attribute_modifiers",
      "display": "属性修饰符",
      "kind": "nbt",
      "group": "attribute",
      "default": "[{\"type\":\"minecraft:attack_damage\",\"amount\":5.0,\"operation\":\"add_value\",\"slot\":\"mainhand\",\"id\":\"example:bonus\"}]",
      "hint": "列表；1.21 用 id 字段（不再是 name）"
    },
    {
      "id": "minecraft:tool",
      "display": "工具挖掘规则",
      "kind": "nbt",
      "group": "attribute",
      "applies": ["tool"],
      "default": "{\"rules\":[{\"blocks\":\"#minecraft:mineable/pickaxe\",\"speed\":8.0}],\"default_mining_speed\":1.0,\"damage_per_block\":1}"
    },
    {
      "id": "minecraft:custom_model_data",
      "display": "自定义模型数据",
      "kind": "int",
      "group": "appearance",
      "default": "0"
    },
    {
      "id": "minecraft:dyed_color",
      "display": "染色",
      "kind": "nbt",
      "group": "appearance",
      "applies": ["leather", "dyeable"],
      "default": "{\"rgb\":16711680}",
      "hint": "{\"rgb\":<十进制 RGB>}，1.21 为 compound"
    },
    {
      "id": "minecraft:base_color",
      "display": "盾牌底色",
      "kind": "enum",
      "group": "appearance",
      "applies": ["banner", "shield"],
      "options": ["white", "orange", "magenta", "light_blue", "yellow", "lime",
                  "pink", "gray", "light_gray", "cyan", "purple", "blue",
                  "brown", "green", "red", "black"],
      "default": "red"
    },
    {
      "id": "minecraft:banner_patterns",
      "display": "旗帜图案",
      "kind": "nbt",
      "group": "appearance",
      "applies": ["banner", "shield"],
      "default": "[{\"pattern\":\"minecraft:stripe_top\",\"color\":\"red\"}]"
    },
    {
      "id": "minecraft:rarity",
      "display": "稀有度",
      "kind": "enum",
      "group": "appearance",
      "options": ["common", "uncommon", "rare", "epic"],
      "default": "common"
    },
    {
      "id": "minecraft:tooltip_style",
      "display": "提示框样式",
      "kind": "text",
      "group": "appearance",
      "default": "minecraft:default"
    },
    {
      "id": "minecraft:trim",
      "display": "盔甲纹饰",
      "kind": "nbt",
      "group": "appearance",
      "applies": ["armor"],
      "default": "{\"material\":\"minecraft:gold\",\"pattern\":\"minecraft:silence\"}"
    },
    {
      "id": "minecraft:profile",
      "display": "玩家头颅皮肤",
      "kind": "nbt",
      "group": "appearance",
      "applies": ["head"],
      "default": "{\"name\":\"Notch\"}",
      "hint": "{\"name\":\"<玩家名>\"} 或 {\"id\":[I;...],\"properties\":[...]}"
    },
    {
      "id": "minecraft:food",
      "display": "食物属性",
      "kind": "nbt",
      "group": "food",
      "applies": ["food"],
      "default": "{\"nutrition\":4,\"saturation\":2.0}"
    },
    {
      "id": "minecraft:potion_contents",
      "display": "药水内容",
      "kind": "nbt",
      "group": "food",
      "applies": ["potion"],
      "default": "{\"potion\":\"minecraft:water\"}",
      "hint": "{\"potion\":\"minecraft:strong_healing\"}；可再加 custom_color"
    },
    {
      "id": "minecraft:fire_resistant",
      "display": "防火（不被烧毁）",
      "kind": "bool",
      "group": "food",
      "default": "1b"
    },
    {
      "id": "minecraft:glider",
      "display": "滑翔（鞘翅效果）",
      "kind": "bool",
      "group": "food",
      "default": "1b"
    },
    {
      "id": "minecraft:ominous_bottle_amplifier",
      "display": "不祥之瓶等级",
      "kind": "int",
      "group": "food",
      "applies": ["potion"],
      "default": "1"
    },
    {
      "id": "minecraft:container",
      "display": "容器内容（潜影盒等）",
      "kind": "nbt",
      "group": "container",
      "applies": ["container"],
      "default": "[{\"slot\":0,\"item\":{\"id\":\"minecraft:stone\",\"count\":1}}]",
      "hint": "列表：[{slot:0,item:{id:…,count:…}}]"
    },
    {
      "id": "minecraft:bundle_contents",
      "display": "收纳袋内容",
      "kind": "nbt",
      "group": "container",
      "applies": ["bundle"],
      "default": "[{\"id\":\"minecraft:stone\",\"count\":1}]"
    },
    {
      "id": "minecraft:charged_projectiles",
      "display": "弩已装填的箭",
      "kind": "nbt",
      "group": "container",
      "applies": ["crossbow"],
      "default": "[{\"id\":\"minecraft:arrow\",\"count\":1}]"
    },
    {
      "id": "minecraft:written_book_content",
      "display": "成书内容",
      "kind": "nbt",
      "group": "container",
      "applies": ["book"],
      "default": "{\"title\":\"我的书\",\"author\":\"Steve\",\"pages\":[\"第一页\"]}",
      "hint": "title/author 必填，pages 为文本组件或 SNBT 字符串列表"
    },
    {
      "id": "minecraft:recipes",
      "display": "合成配方解锁",
      "kind": "nbt",
      "group": "container",
      "applies": ["book"],
      "default": "[\"minecraft:stick\"]"
    },
    {
      "id": "minecraft:max_stack_size",
      "display": "最大堆叠数",
      "kind": "int",
      "group": "misc",
      "default": "64",
      "hint": "1~99；会影响同一格能否堆叠"
    },
    {
      "id": "minecraft:custom_data",
      "display": "自定义数据（插件用）",
      "kind": "nbt",
      "group": "misc",
      "default": "{\"myplugin\":{\"level\":3}}"
    },
    {
      "id": "minecraft:map_id",
      "display": "地图编号",
      "kind": "int",
      "group": "misc",
      "applies": ["map"],
      "default": "0"
    },
    {
      "id": "minecraft:note_block_sound",
      "display": "头颅播放的音效",
      "kind": "text",
      "group": "misc",
      "applies": ["head"],
      "default": "minecraft:entity.zombie.ambient"
    },
    {
      "id": "minecraft:jukebox_playable",
      "display": "唱片机曲目",
      "kind": "text",
      "group": "misc",
      "default": "minecraft:cat"
    },
    {
      "id": "minecraft:instrument",
      "display": "山羊角乐器",
      "kind": "text",
      "group": "misc",
      "default": "minecraft:ponder_goat_horn"
    }
  ]
}
